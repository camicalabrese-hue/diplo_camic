<div class="container" style="margin-top: 30px;">

    <div class="row">
        <p class="text-end">
            Hola {{usuario}}!
            <a class="btn btn-danger btn-sm" href="/admin/logout">
                Cerrar sesión <i class="fas fa-sign-out-alt"></i>
            </a>
        </p>
    </div>



    <div class="row align-items-center mb-3">
        <div class="col-7">
            <h3>Listado de Novedades</h3>
        </div>
        <div class="col-5 text-end">
            <a class="btn btn-success" href="/admin/novedades/agregar">
                <i class="fas fa-plus"></i> Nuevo
            </a>
        </div>
    </div>


    {{#if error}}
    <div class="row">
        <div class="col">
            <div class="alert alert-danger" role="alert">
                {{message}}
            </div>
        </div>
    </div>
    {{/if}}


    <div class="row">
        <div class="col">
            <table class="table table-striped">
                <thead>
                    <tr class="table-primary">
                        <th scope="col">#</th>
                        <th scope="col">Imagen</th>
                        <th scope="col">Título</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each novedades}}
                    <tr>
                        <th scope="row">{{id}}</th>
                        <td>{{{imagen}}}</td>
                        <td>{{titulo}}</td>
                        <td class="text-end">
                            <a href="/admin/novedades/editar/{{id}}" title="Editar" class="btn btn-sm btn-primary">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a href="/admin/novedades/eliminar/{{id}}" title="Eliminar" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

</div>